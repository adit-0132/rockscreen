<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The lyrics cache (listening history) is excluded from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
